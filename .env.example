# -----------------------------------------------------------------------------
# SUPABASE CLIENT CONFIGURATION (PUBLIC / FRONTEND)
# -----------------------------------------------------------------------------
# 1. Create or open your project at https://supabase.com
# 2. Go to Project Settings -> API
# 3. Copy "Project URL" and paste below as VITE_SUPABASE_URL
# 4. Copy "anon public" / Publishable Key and paste below as VITE_SUPABASE_ANON_KEY
# 5. NEVER expose your "service_role" secret key in VITE_* frontend variables!
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-publishable-key"

# -----------------------------------------------------------------------------
# PAYU HOSTED CHECKOUT CONFIGURATION (OPTIONAL NODE SERVER / SUPABASE EDGE FN)
# -----------------------------------------------------------------------------
# For static Hostinger shared hosting, configure these in Supabase Edge Function
# secrets for `payu-checkout`. For Hostinger Node.js Web App hosting, set them
# in the Hostinger Environment Variables panel.
# PayU Environment: "TEST" (Sandbox) or "LIVE" (Production)
PAYU_ENV="TEST"
PAYU_MERCHANT_KEY="YOUR_PAYU_MERCHANT_KEY"
PAYU_MERCHANT_SALT="YOUR_PAYU_MERCHANT_SALT"
